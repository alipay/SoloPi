    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.2",
    "@hookform/resolvers": "^3.10.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "ajv": "8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "latest",
    "input-otp": "^1.4.2",
    "lucide-react": "latest",
    "mammoth": "1.13.0",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "4.10.38",
    "picomatch": "file:vendor/picomatch",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.5",
    "reactflow": "latest",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "latest",
    "vaul": "^0.9.9",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "acorn": "8.16.0",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "electron": "44.11.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "follow-redirects": "1.16.2",
    "globals": "^15.15.0",
    "html-webpack-plugin": "^5.5.3",
    "less": "^4.2.0",
    "less-loader": "^12.0.0",
    "node-forge": "1.4.3",
    "postcss": "^8.5.6",
    "postcss-loader": "^7.3.0",
    "semver": "^7.7.3",
    "style-loader": "^3.3.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tar": "7.5.23",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^6.1.0"
  },
  "build": {
    "appId": "com.glassbox.desktop",
    "productName": "solopi-desktop",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "electron/agent/support-export.js",
      "electron/agent/case-evidence-export.js",
      "electron/diagnostics.js",
      "electron/report-performance-diagnostics.js",
      "electron/agent/diagnostic-fields.js",
      "electron/agent/upstream-diagnostics.js"
    ],
    "files": [
      "dist/**/*",
      "electron/adb-error.js",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/solopi-recording",
        "to": "solopi-recording"
      },
      {
        "from": "resources/branding",
        "to": "branding",
        "filter": [
          "NOTICE.md",
          "SoloPi-LICENSE.txt"
        ]
      },
      {
        "from": "resources/branding/solopi-desktop-app-icon.png",
        "to": "dock-icon.png"
      },
      {
        "from": "scripts/glassbox-cli.mjs",
        "to": "cli/glassbox-cli.mjs"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/media-runtime/darwin-arm64",
        "to": "media-runtime/darwin-arm64"
      },
      {
        "from": "skills/solopi-desktop-cli",
        "to": "skills/solopi-desktop-cli",
        "filter": [
          "SKILL.md",
          "agents/**",
          "references/**"
        ]
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!**/*.jar",
          "!quick-actions{,/**}",
          "!media-runtime{,/**}",
          "!.DS_Store",
          "!git-runtime{,/**}",
          "!device-harness{,/**}"
        ]
      },
      {
        "from": "resources/git-runtime/darwin-arm64",
        "to": "git-runtime/darwin-arm64"
      },
      {
        "from": "build/packaged-cli",
        "to": "cli",
        "filter": [
          "*.cjs",
          "*.js",
          "agent/receipt-timing.js",
          "runtime-build.json"
        ]
      },
      {
        "from": "resources/device-harness",
        "to": "harness",
        "filter": [
          "**/*.py",
          "**/resources/**",
          "!**/__pycache__/**"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "sign": "./scripts/electron-builder-sign.mjs",
      "electronLanguages": [
        "en",
        "zh_CN"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://glassbox.example.com/releases/"
      }
    ],
    "afterPack": "scripts/verify-packaged-runtime-after-pack.cjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "node-forge": "1.4.3",
    "glob@>=9 <15": "14.0.6",
    "minimatch@>=7 <12": "11.0.9",
    "postcss-selector-parser@^6.0.0": "6.1.6",
    "postcss-selector-parser@^7.0.0": "7.2.1",
    "picomatch": "$picomatch"
  }
}
