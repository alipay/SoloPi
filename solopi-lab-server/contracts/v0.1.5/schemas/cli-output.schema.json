{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopi-lab/contracts/v0.1.1/cli-output.schema.json",
  "title": "CliOutputEnvelope",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "data"],
      "additionalProperties": false,
      "properties": {
        "ok": { "const": true },
        "data": { "type": "object", "additionalProperties": true }
      }
    },
    {
      "type": "object",
      "required": ["ok", "error"],
      "additionalProperties": false,
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_FAILED", "AUTH_REQUIRED", "AUTH_TOKEN_INVALID",
                "AUTH_CHALLENGE_EXPIRED", "AUTH_REVOKED", "AUTH_SCOPE_DENIED",
                "ENROLL_NOT_FOUND", "CLIENT_NOT_FOUND", "TASK_NOT_FOUND",
                "SESSION_EPOCH_CONFLICT", "ENROLL_KEY_ROTATION_CONFLICT",
                "ENROLL_ALREADY_DECIDED", "CMD_DIGEST_CONFLICT", "RESOURCE_BUSY",
                "ENROLL_RECOVERY_KEY_MISMATCH", "RATE_LIMITED", "INTERNAL", "UNAVAILABLE"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "details": { "type": "object", "additionalProperties": true },
            "retryAfterSec": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      }
    }
  ]
}
