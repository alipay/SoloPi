{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopi-lab/contracts/v0.4.0/error.schema.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_FAILED",
            "AUTH_REQUIRED",
            "AUTH_TOKEN_INVALID",
            "AUTH_CHALLENGE_EXPIRED",
            "AUTH_REVOKED",
            "AUTH_SCOPE_DENIED",
            "ENROLL_NOT_FOUND",
            "CLIENT_NOT_FOUND",
            "TASK_NOT_FOUND",
            "SESSION_EPOCH_CONFLICT",
            "ENROLL_KEY_ROTATION_CONFLICT",
            "ENROLL_ALREADY_DECIDED",
            "CMD_DIGEST_CONFLICT",
            "RESOURCE_BUSY",
            "ENROLL_RECOVERY_KEY_MISMATCH",
            "SNAPSHOT_CONFLICT",
            "SNAPSHOT_SEQ_GAP",
            "DEVICE_IDENTITY_CONFLICT",
            "MEDIA_SESSION_INVALID",
            "MEDIA_TICKET_INVALID",
            "RATE_LIMITED",
            "INTERNAL",
            "UNAVAILABLE",
            "AGENT_TASK_INVALID",
            "AGENT_TASK_CONFLICT",
            "GROUP_INVALID",
            "GROUP_REGISTRATION_CONFLICT",
            "GROUP_REVISION_CONFLICT",
            "GROUP_DUPLICATE_MEMBER",
            "GROUP_OWNER_MISMATCH",
            "GROUP_NOT_FOUND",
            "GROUP_DELETED",
            "GROUP_RUNNER_UNSUPPORTED",
            "GROUP_DEVICE_IDENTITY_MISMATCH",
            "GROUP_DEVICE_OFFLINE",
            "GROUP_BUSY",
            "GROUP_EXECUTION_CONFLICT",
            "GROUP_EXECUTION_NOT_FOUND",
            "GROUP_STOP_REQUESTED",
            "GROUP_RECONCILIATION_REQUIRED",
            "GROUP_PAYLOAD_OUTSIDE_SNAPSHOT",
            "GROUP_PROJECTION_INVALID_TRANSITION"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "retryAfterSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
