{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopi-lab/contracts/v0.4.0/group-registration.schema.json",
  "title": "GroupRegistrationTypes",
  "$defs": {
    "clientId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "groupId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "Desktop生成的组身份；重名不当身份；Server绝不写回" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "registrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "groupId", "revision", "name", "deleted", "members"],
      "properties": {
        "clientId": { "$ref": "#/$defs/clientId" },
        "groupId": { "$ref": "#/$defs/groupId" },
        "revision": { "$ref": "#/$defs/revision" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deleted": { "type": "boolean" },
        "members": { "type": "array", "minItems": 1, "maxItems": 128, "items": {
          "type": "object", "additionalProperties": false, "required": ["deviceId", "role"],
          "properties": {
            "deviceId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$", "description": "本Desktop已验证设备清单内稳定ULID" },
            "role": { "type": "string", "minLength": 1, "maxLength": 64, "description": "显式串；注册层不限制枚举；准入限制由Desktop runner实施(GROUP_RUNNER_UNSUPPORTED)" }
          }
        }}
      },
      "description": "wire白名单硬拒绝serial/fingerprint/sourceIdentity——源身份映射为Desktop私有本地校验值"
    },
    "registrationAck": {
      "type": "object", "additionalProperties": false,
      "required": ["groupId", "revision", "accepted", "currentRevision"],
      "properties": {
        "groupId": { "$ref": "#/$defs/groupId" },
        "revision": { "$ref": "#/$defs/revision" },
        "accepted": { "type": "boolean" },
        "currentRevision": { "$ref": "#/$defs/revision" },
        "stale": { "type": "boolean", "description": "true=上送revision低于投影当前值，未覆盖，回当前供对账游标" }
      }
    }
  }
}
