{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopi-lab/contracts/v0.4.0/group-execution.schema.json",
  "title": "GroupExecutionTypes",
  "$defs": {
    "uuidv4": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "clientId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "snapshot": { "type": "object", "additionalProperties": false, "required": ["groupId", "revision", "members"],
      "properties": {
        "groupId": { "$ref": "#/$defs/uuidv4" },
        "revision": { "type": "integer", "minimum": 1 },
        "members": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["deviceId", "role"],
          "properties": { "deviceId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }, "role": { "type": "string", "minLength": 1, "maxLength": 64 } } } }
      },
      "description": "不可变执行快照：组删除后仍自证；Server只投影不重写" },
    "receipt": { "type": "object", "additionalProperties": false, "required": ["taskId", "terminal", "resourcesReleased", "outcome"],
      "properties": {
        "taskId": { "$ref": "#/$defs/uuidv4" },
        "terminal": { "const": true },
        "resourcesReleased": { "const": true },
        "outcome": { "enum": ["succeeded", "failed", "cancelled"] },
        "reportRef": { "type": ["string", "null"], "minLength": 1, "maxLength": 512, "description": "可信native结果引用" }
      }},
    "executionProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["groupExecutionId", "clientId", "groupSnapshot", "requestId", "taskId", "phase", "eventSeq"],
      "properties": {
        "groupExecutionId": { "$ref": "#/$defs/uuidv4" },
        "clientId": { "$ref": "#/$defs/clientId" },
        "groupSnapshot": { "$ref": "#/$defs/snapshot" },
        "requestId": { "$ref": "#/$defs/uuidv4", "description": "native请求身份——只绑定一个groupExecutionId" },
        "taskId": { "$ref": "#/$defs/uuidv4", "description": "native准备钩子的真实runner任务ID，非Server猜测UUID；只绑定一个groupExecutionId" },
        "phase": { "enum": ["prepared", "dispatching", "unknown", "done"] },
        "stopRequestedAt": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d+)?Z$", "description": "RFC3339 UTC——仅记录取消意图，不是停止/释放证明；一经持久化不得被省略可选字段的后续事件擦除（模块强制持久事实层）" },
        "receipt": { "$ref": "#/$defs/receipt" },
        "eventSeq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Desktop本地组事件游标——与组revision、既有任务event流均为不同游标" }
      }
    },
    "executionAck": { "type": "object", "additionalProperties": false, "required": ["groupExecutionId", "phase", "eventSeq", "accepted"],
      "properties": {
        "groupExecutionId": { "$ref": "#/$defs/uuidv4" }, "phase": { "enum": ["prepared", "dispatching", "unknown", "done"] },
        "eventSeq": { "type": "integer", "minimum": 0 }, "accepted": { "type": "boolean" },
        "currentEventSeq": { "type": "integer", "minimum": 0 }, "stale": { "type": "boolean" }
      }}
  }
}
