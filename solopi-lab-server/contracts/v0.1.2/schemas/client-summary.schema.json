{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopi-lab/contracts/v0.1.2/client-summary.schema.json",
  "title": "ClientTypes",
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "nullableUtc": { "oneOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }] },
    "clientSummary": {
      "type": "object",
      "required": ["orgId", "projectId", "clientId", "installationId", "keyFingerprint", "status", "online", "lastHeartbeatAt", "leaseExpiresAt", "clientVersion", "capabilities", "occupancy", "deviceScope"],
      "additionalProperties": false,
      "properties": {
        "orgId": { "$ref": "#/$defs/ulid" },
        "projectId": { "$ref": "#/$defs/ulid" },
        "clientId": { "$ref": "#/$defs/ulid" },
        "installationId": { "$ref": "#/$defs/ulid" },
        "keyFingerprint": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]+$" },
        "status": { "enum": ["pending", "approved", "revoked", "expired", "rejected"] },
        "online": { "enum": ["online", "offline", "unknown"] },
        "lastHeartbeatAt": { "$ref": "#/$defs/nullableUtc" },
        "leaseExpiresAt": { "$ref": "#/$defs/nullableUtc" },
        "clientVersion": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "required": ["commands", "media"],
          "additionalProperties": false,
          "properties": { "commands": { "type": "boolean" }, "media": { "type": "boolean" } }
        },
        "occupancy": {
          "type": "object",
          "required": ["localUiTasks", "cliTasks"],
          "additionalProperties": false,
          "properties": {
            "localUiTasks": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "cliTasks": { "type": "integer", "minimum": 0, "maximum": 100000 }
          }
        },
        "deviceScope": {
          "type": "object",
          "required": ["deviceId", "os", "hostname"],
          "additionalProperties": false,
          "properties": {
            "deviceId": { "type": "string", "minLength": 1 },
            "os": { "type": "string", "minLength": 1 },
            "hostname": { "type": "string", "minLength": 1 },
            "description": { "type": "string" }
          }
        },
        "grantedAt": { "$ref": "#/$defs/nullableUtc" },
        "validUntil": { "$ref": "#/$defs/nullableUtc" }
      }
    },
    "clientsPage": {
      "type": "object",
      "required": ["items", "page", "pageSize", "nextPage"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/clientSummary" } },
        "page": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "nextPage": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, { "type": "null" }] }
      }
    },
    "clientAdminResponse": {
      "description": "revoke/renew 响应：管理端凭证已验，允许含身份字段",
      "type": "object",
      "required": ["clientId", "status"],
      "additionalProperties": false,
      "properties": {
        "clientId": { "$ref": "#/$defs/ulid" },
        "status": { "enum": ["approved", "revoked"] },
        "validUntil": { "$ref": "#/$defs/utc" },
        "revokedAt": { "$ref": "#/$defs/utc" }
      }
    }
  }
}
