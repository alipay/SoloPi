{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopi-lab/contracts/v0.1.1/command.schema.json",
  "title": "CommandTypes",
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "commandEnvelope": {
      "type": "object",
      "required": ["commandId", "taskId", "epoch", "digest", "issuedAt", "expiresAt", "type", "payload"],
      "additionalProperties": false,
      "properties": {
        "commandId": { "$ref": "#/$defs/ulid" },
        "taskId": { "$ref": "#/$defs/ulid" },
        "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$" },
        "issuedAt": { "$ref": "#/$defs/utc" },
        "expiresAt": { "$ref": "#/$defs/utc" },
        "type": { "enum": ["run_case", "stop", "upload_artifact", "report_state"] },
        "payload": { "type": "object", "additionalProperties": true }
      }
    },
    "commandResultRequest": {
      "type": "object",
      "required": ["taskId", "digest", "epoch", "outcome"],
      "additionalProperties": false,
      "properties": {
        "taskId": { "$ref": "#/$defs/ulid" },
        "digest": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$" },
        "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "outcome": { "enum": ["succeeded", "failed", "stopped", "expired", "rejected", "unknown"] },
        "resultRef": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "taskState": {
      "enum": [
        "queued", "dispatched", "stop_requested", "reconciling",
        "succeeded", "failed", "stopped", "abandoned", "unknown"
      ]
    }
  }
}
