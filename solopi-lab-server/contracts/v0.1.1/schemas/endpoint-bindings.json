{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopi-lab/contracts/v0.1.1/endpoint-bindings.json",
  "title": "端点↔Schema 可执行绑定（校验实例必须经本表 $ref，不得把 $defs 文件根当请求 Schema）",
  "contractVersion": "0.1.1",
  "auth": {
    "adminBearer": "§0.6 管理主体 Bearer；scope 由主体绑定解析，请求参数不构成授权",
    "clientSession": "Client session Bearer；Bearer+body.sessionId+body.epoch 三者一致（§2.1）",
    "none": "匿名（仅注册申请与 challenge 两类端点）"
  },
  "endpoints": [
    { "method": "POST", "path": "/v1/enrollments", "auth": "none",
      "request": "enrollment.schema.json#/$defs/enrollmentCreateRequest",
      "success": { "201": "enrollment.schema.json#/$defs/enrollmentResponse",
                   "200": "enrollment.schema.json#/$defs/enrollmentResponse" } },
    { "method": "GET", "path": "/v1/enrollments", "auth": "adminBearer",
      "success": { "200": "client-summary.schema.json#/$defs/clientsPage", "note": "items 为 enrollment 行；阶段A复用分页壳，行Schema按列表列定义" } },
    { "method": "GET", "path": "/v1/enrollments/{enrollmentId}", "auth": "adminBearer",
      "success": { "200": "enrollment.schema.json#/$defs/enrollmentResponse" } },
    { "method": "POST", "path": "/v1/enrollments/{enrollmentId}/decision", "auth": "adminBearer",
      "request": "enrollment.schema.json#/$defs/decisionRequest",
      "success": { "200": "enrollment.schema.json#/$defs/enrollmentResponse" } },
    { "method": "POST", "path": "/v1/clients/{clientId}/revoke", "auth": "adminBearer",
      "request": "enrollment.schema.json#/$defs/revokeRequest",
      "success": { "200": "enrollment.schema.json#/$defs/enrollmentResponse" } },
    { "method": "POST", "path": "/v1/clients/{clientId}/renew", "auth": "adminBearer",
      "request": "enrollment.schema.json#/$defs/renewRequest",
      "success": { "200": "enrollment.schema.json#/$defs/enrollmentResponse" } },
    { "method": "POST", "path": "/v1/enrollments/recover/challenge", "auth": "none",
      "request": "enrollment.schema.json#/$defs/recoverChallengeRequest",
      "success": { "200": "session.schema.json#/$defs/challengeResponse" } },
    { "method": "POST", "path": "/v1/enrollments/recover", "auth": "none",
      "request": "enrollment.schema.json#/$defs/recoverRequest",
      "success": { "200": "enrollment.schema.json#/$defs/enrollmentResponse" } },
    { "method": "GET", "path": "/v1/sessions/challenge", "auth": "none",
      "success": { "200": "session.schema.json#/$defs/challengeResponse" } },
    { "method": "POST", "path": "/v1/sessions", "auth": "none",
      "request": "session.schema.json#/$defs/sessionCreateRequest",
      "success": { "201": "session.schema.json#/$defs/sessionCreateResponse" } },
    { "method": "POST", "path": "/v1/heartbeat", "auth": "clientSession",
      "request": "heartbeat.schema.json#/$defs/heartbeatRequest",
      "success": { "200": "heartbeat.schema.json#/$defs/heartbeatResponse" } },
    { "method": "GET", "path": "/v1/clients", "auth": "adminBearer",
      "success": { "200": "client-summary.schema.json#/$defs/clientsPage" } },
    { "method": "GET", "path": "/v1/clients/{clientId}", "auth": "adminBearer",
      "success": { "200": "client-summary.schema.json#/$defs/clientSummary" } },
    { "method": "GET", "path": "/v1/events", "auth": "adminBearer|clientSession",
      "success": { "200": "event.schema.json#/$defs/eventsPage" } },
    { "method": "POST", "path": "/v1/events/ack", "auth": "clientSession",
      "request": "event.schema.json#/$defs/ackRequest",
      "success": { "200": "event.schema.json#/$defs/ackResponse" } },
    { "method": "GET", "path": "/v1/healthz", "auth": "none",
      "success": { "200": "healthz.schema.json#/$defs/healthzResponse" } }
  ]
}
