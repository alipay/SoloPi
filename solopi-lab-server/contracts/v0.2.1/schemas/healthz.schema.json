{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopi-lab/contracts/v0.1.1/healthz.schema.json",
  "title": "HealthTypes",
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "healthzResponse": {
      "type": "object",
      "required": ["status", "serverTime", "contractVersion", "dbMigrationVersion"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["ok", "degraded"] },
        "serverTime": { "$ref": "#/$defs/utc" },
        "contractVersion": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
        "dbMigrationVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
